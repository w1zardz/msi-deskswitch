+fn is_physical_goxlr(transport: u32, name: &str, manufacturer: &str, uid: &str) -> bool {
+    if transport != kAudioDeviceTransportTypeUSB
+        || uid.starts_with(AGGREGATE_PREFIX)
+        || uid.starts_with(LEGACY_PREFIX)
+    {
+        return false;
+    }
+    let model_matches = matches!(name, "GoXLR" | "GoXLR Mini");
+    let usb_uid_matches = [
+        "AppleUSBAudioEngine:TC-Helicon:GoXLR:",
+        "AppleUSBAudioEngine:TC-Helicon:GoXLR Mini:",
+    ]
+    .iter()
+    .any(|prefix| {
+        uid.strip_prefix(prefix)
+            .is_some_and(|suffix| !suffix.is_empty())
+    });
+    (model_matches && manufacturer == "TC-Helicon") || usb_uid_matches
+}
+
+fn core_audio_address(selector: u32) -> AudioObjectPropertyAddress {
+    AudioObjectPropertyAddress {
+        mSelector: selector,
+        mScope: kAudioObjectPropertyScopeGlobal,
+        mElement: kAudioObjectPropertyElementMaster,
+    }
+}
+
+fn read_core_audio_numbers(id: AudioObjectID, selector: u32) -> Result<Vec<u32>> {
+    let address = core_audio_address(selector);
+    let mut size = 0u32;
+    let status = unsafe { AudioObjectGetPropertyDataSize(id, &address, 0, null(), &mut size) };
+    if status != kAudioHardwareNoError as i32 || !size.is_multiple_of(4) {
+        bail!("CoreAudio property size error: {status}, size {size}");
+    }
+    if size == 0 {
+        return Ok(Vec::new());
+    }
+    let capacity_bytes = size;
+    let mut values = vec![0u32; size as usize / mem::size_of::<u32>()];
+    let status = unsafe {
+        AudioObjectGetPropertyData(
+            id,
+            &address,
+            0,
+            null(),
+            &mut size,
+            values.as_mut_ptr().cast(),
+        )
+    };
+    if status != kAudioHardwareNoError as i32 || size > capacity_bytes || !size.is_multiple_of(4) {
+        bail!("CoreAudio property read error: {status}, size {size}");
+    }
+    // The device list can shrink between the size and data reads.
+    values.truncate(size as usize / mem::size_of::<u32>());
+    Ok(values)
+}
+
+fn read_core_audio_string(id: AudioObjectID, selector: u32) -> Result<String> {
+    let address = core_audio_address(selector);
+    let mut value: CFStringRef = null();
+    let mut size = mem::size_of::<CFStringRef>() as u32;
+    let status = unsafe {
+        AudioObjectGetPropertyData(
+            id,
+            &address,
+            0,
+            null(),
+            &mut size,
+            (&mut value as *mut CFStringRef).cast(),
+        )
+    };
+    if status != kAudioHardwareNoError as i32 || value.is_null() {
+        bail!("CoreAudio string property read error: {status}");
+    }
+    // CoreAudio transfers ownership of UID/name/manufacturer CFStrings to the caller.
+    let value = unsafe { CFString::wrap_under_create_rule(value) };
+    if size as usize != mem::size_of::<CFStringRef>() {
+        bail!("CoreAudio string property size error: {size}");
+    }
+    Ok(value.to_string())
+}
+
+fn get_goxlr_core_audio_devices() -> Result<Vec<CoreAudioDevice>> {
+    let ids = read_core_audio_numbers(kAudioObjectSystemObject, kAudioHardwarePropertyDevices)?;
+    let mut devices = Vec::new();
+    for id in ids {
+        let Ok(transport) = read_core_audio_numbers(id, kAudioDevicePropertyTransportType) else {
+            continue; // Devices may disappear while the list is being read.
+        };
+        if transport.as_slice() != [kAudioDeviceTransportTypeUSB] {
+            continue;
+        }
+        let Ok(uid) = read_core_audio_string(id, kAudioDevicePropertyDeviceUID) else {
+            continue;
+        };
+        let Ok(name) = read_core_audio_string(id, kAudioObjectPropertyName) else {
+            continue;
+        };
+        let manufacturer =
+            read_core_audio_string(id, kAudioObjectPropertyManufacturer).unwrap_or_default();
+        if is_physical_goxlr(transport[0], &name, &manufacturer, &uid) {
+            devices.push(CoreAudioDevice {
+                display_name: name,
+                uid,
+            });
+        }
+    }
+    Ok(devices)
+}

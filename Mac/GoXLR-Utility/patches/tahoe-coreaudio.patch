+#[cfg(test)]
+mod tahoe_tests {
+    use super::*;
+
+    #[test]
+    fn accepts_only_full_and_mini_with_verified_usb_identity() {
+        for model in ["GoXLR", "GoXLR Mini"] {
+            assert!(is_physical_goxlr(
+                kAudioDeviceTransportTypeUSB,
+                model,
+                "TC-Helicon",
+                "opaque-uid"
+            ));
+            let uid = format!("AppleUSBAudioEngine:TC-Helicon:{model}:1234000:1,2");
+            assert!(is_physical_goxlr(
+                kAudioDeviceTransportTypeUSB,
+                "renamed device",
+                "",
+                &uid
+            ));
+            assert!(!is_physical_goxlr(0, model, "TC-Helicon", &uid));
+            assert!(!is_physical_goxlr(
+                kAudioDeviceTransportTypeUSB,
+                model,
+                "Other vendor",
+                "opaque-uid"
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_aggregates_and_similar_names() {
+        for uid in [
+            "GoXLR-Utility::Aggregate::x::System",
+            "com.adecorp.goxlr.system",
+        ] {
+            assert!(!is_physical_goxlr(
+                kAudioDeviceTransportTypeUSB,
+                "GoXLR",
+                "TC-Helicon",
+                uid
+            ));
+        }
+        for model in ["GoXLR Virtual", "GoXLR Miniature", "Not GoXLR"] {
+            let uid = format!("AppleUSBAudioEngine:TC-Helicon:{model}:1234000:1,2");
+            assert!(!is_physical_goxlr(
+                kAudioDeviceTransportTypeUSB,
+                model,
+                "TC-Helicon",
+                &uid
+            ));
+        }
+        assert!(!is_physical_goxlr(
+            kAudioDeviceTransportTypeUSB,
+            "Other",
+            "",
+            "AppleUSBAudioEngine:TC-Helicon:GoXLR:"
+        ));
+    }
+
+    #[test]
+    #[ignore = "requires a connected GoXLR; reads properties without changing audio or USB"]
+    fn discovers_connected_goxlr_read_only() {
+        let devices = get_goxlr_core_audio_devices().expect("CoreAudio enumeration");
+        assert!(!devices.is_empty(), "No physical USB GoXLR detected");
+        for device in devices {
+            println!("Detected physical device: {}", device.display_name);
+        }
+    }
+}
